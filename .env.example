# === DCT-MD .env.example ===
# Railway > Project > Variables ekata mewa danna.

# --- REQUIRED ---
# ⚠️ Kalin config.js eke thibba URI eka public wela thibba (password ekath ekka).
# MongoDB Atlas -> Database Access -> user -> Edit -> reset password karala AWAT
# meka danna. Password eka database URL eke NEVER hardcode karanna epa (mehema
# .env / Railway Variables walin witharai denna one).
MONGODB_URI=

# --- DASHBOARD (/dashboard) ---
# Required now — value ekak nathnam dashboard/admin API okkොම lock wela thiyewi.
# Long random string ekak danna (e.g. openssl rand -hex 16 kiyala generate karanna puluwan).
ADMIN_KEY=

# --- USER PANEL LINK (bot connect unama WhatsApp eken evana link eke domain eka) ---
# Railway eken RAILWAY_PUBLIC_DOMAIN auto denawa, e nisa methana danna one nathi wenna puluwan.
PANEL_BASE_URL=

# --- OPTIONAL ---
PORT=3000
NEWSLETTER_JID=120363395674230271@newsletter
